# ═══════════════════════════════════════════════════════════
# Finance App — Variáveis de Ambiente
# Copie: cp .env.example .env  e preencha os valores reais.
# NUNCA commite o arquivo .env no git.
# ═══════════════════════════════════════════════════════════

# ── Servidor ──────────────────────────────────────────────
NODE_ENV=development        # development | production
PORT=3001                   # Porta do servidor Express

# ── Banco de dados ────────────────────────────────────────
# Neon PostgreSQL — obtenha em https://neon.tech
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Autenticação ──────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=sua_chave_secreta_aleatoria_minimo_64_chars

# ── E-mail (relatórios PDF e reset de senha) ──────────────
# Configure Gmail + App Password (não use senha da conta)
# Guia: https://support.google.com/accounts/answer/185833
EMAIL_USER=seu_email@gmail.com
EMAIL_PASS=xxxx_xxxx_xxxx_xxxx   # App Password do Gmail (16 chars)

# ── Web Push (notificações PWA) ───────────────────────────
# Gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=sua_chave_publica_vapid
VAPID_PRIVATE_KEY=sua_chave_privada_vapid

# ── IA — Groq (agente financeiro) ────────────────────────
# Obtenha em https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
