# ═══════════════════════════════════════════════════════════
# FinançasPro — Variáveis de Ambiente
#
# Como usar:
#   cp .env.example .env
#   Preencha os valores no arquivo .env
#
# IMPORTANTE: Nunca commite o arquivo .env no git.
#             Somente .env.example vai para o repositório.
# ═══════════════════════════════════════════════════════════


# ── Servidor ──────────────────────────────────────────────
NODE_ENV=development          # development | production
PORT=3001                     # Porta do Express (Cloud Run usa 8080 via variável de ambiente automática)


# ── Banco de Dados ────────────────────────────────────────
# Supabase PostgreSQL — obtenha em https://supabase.com (Settings > Database)
# Porta 5432 = conexão direta | Porta 6543 = PgBouncer (pooling)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres?sslmode=require


# ── Autenticação JWT ──────────────────────────────────────
# Gere uma chave forte com:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=substitua_por_string_aleatoria_de_minimo_64_caracteres


# ── URL da Aplicação ──────────────────────────────────────
# Usado para gerar o link de reset de senha nos e-mails
# Em desenvolvimento: http://localhost:3001
# Em produção: URL do Cloud Run ou domínio customizado
APP_URL=http://localhost:3001


# ── CORS (produção) ───────────────────────────────────────
# URLs que podem chamar a API, separadas por vírgula.
# Deixe vazio em desenvolvimento (sem validação de origem).
ALLOWED_ORIGINS=https://seu-app.run.app


# ── E-mail (relatórios PDF e reset de senha) ──────────────
# Requer conta Gmail + App Password (não use a senha normal)
# Como criar App Password: https://support.google.com/accounts/answer/185833
EMAIL_USER=seu_email@gmail.com
EMAIL_PASS=xxxx_xxxx_xxxx_xxxx    # App Password do Gmail (16 caracteres, sem espaços)


# ── Web Push (notificações PWA) ───────────────────────────
# Gere as chaves VAPID com:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=BExemplo_chave_publica_VAPID_base64url
VAPID_PRIVATE_KEY=exemplo_chave_privada_VAPID_base64url


# ── IA — Groq (agente financeiro) ────────────────────────
# Obtenha sua chave gratuita em https://console.groq.com
# Usado para: chat com agente, previsão de gastos, relatório mensal com IA
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ── Plano Pro — Upgrade ───────────────────────────────────
# Segredo para ativar plano Pro via POST /api/auth/upgrade
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Deixe em branco para desativar o endpoint de upgrade.
UPGRADE_SECRET=segredo_para_ativar_plano_pro


# ── Monitor de Disponibilidade ────────────────────────────
# Usado pelo finance-monitor (Vercel) para enviar alertas push quando o app cai
# MONITOR_SECRET: autentica o webhook POST /api/monitor-alert
# MONITOR_COOLDOWN_MINUTES: intervalo mínimo entre alertas push (padrão: 15)
MONITOR_SECRET=segredo_do_monitor_de_disponibilidade
MONITOR_COOLDOWN_MINUTES=15


# ── Analytics — PostHog ───────────────────────────────────
# Injetado em runtime via /app-config.js (sem rebuild Docker ao trocar de projeto)
# Obtenha em https://posthog.com → Project Settings → Project API Key
# Deixe em branco para desativar analytics (no-op automático).
POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
POSTHOG_HOST=https://us.i.posthog.com   # ou https://eu.i.posthog.com para região EU
