# ── Segurança JWT ─────────────────────────────────────
# Gerar com: openssl rand -hex 32
JWT_SECRET=

# ── E-mail (Relatórios Mensais) ───────────────────────
# App Password do Google: https://myaccount.google.com/apppasswords
EMAIL_USER=
EMAIL_PASS=

# ── Banco de dados ────────────────────────────────────
# Neon: https://neon.tech
DATABASE_URL=

# ── Porta do Backend ──────────────────────────────────
PORT=3001

# ── Agente IA (Groq — gratuito) ──────────────────────
# Obter em: https://console.groq.com/keys
GROQ_API_KEY=

# ── Web Push (Notificações) ───────────────────────────
# Gerar com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
