{
  "name": "nancy",
  "version": "1.0.0",
  "private": true,
  "description": "Nancy — Controle financeiro pessoal com IA, PWA e relatórios em PDF",
  "scripts": {
    "dev": "docker compose up",
    "dev:build": "docker compose up --build",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "stop": "docker compose down",
    "logs": "docker compose logs -f",
    "db:studio": "cd backend && npx prisma studio",
    "db:migrate": "cd backend && npx prisma migrate dev",
    "db:generate": "cd backend && npx prisma generate",
    "db:reset": "cd backend && npx prisma migrate reset",
    "install:all": "cd backend && npm install && cd ../frontend && npm install",
    "lint": "cd backend && npm run lint && cd ../frontend && npm run lint",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "index.js",
  "devDependencies": {
    "@playwright/test": "^1.62.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andr3Q/finance-app.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Andr3Q/finance-app/issues"
  },
  "homepage": "https://github.com/Andr3Q/finance-app#readme"
}
