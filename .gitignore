# ── Dependências ──────────────────────────────────────
node_modules/
backend/node_modules/
frontend/node_modules/

# ── Variáveis de ambiente (NUNCA commitar) ────────────
.env
.env.*
!.env.example

# ── Chaves, certificados e credenciais de nuvem (NUNCA commitar) ──────
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
*-service-account*.json
.aws/
.kube/
.gcloud/
.npmrc

# ── Build outputs ──────────────────────────────────────
dist/
frontend/dist/
build/
*.tsbuildinfo

# ── Logs ──────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Cache ─────────────────────────────────────────────
.cache/
.vite/
frontend/.vite/

# ── Sistema operacional ────────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo

# ── Prisma ────────────────────────────────────────────
backend/prisma/*.db
backend/prisma/*.db-journal

# ── Trivy (scanner de segurança — DB local grande demais para o git) ──
backend/.trivy-cache/

# ── Docker ────────────────────────────────────────────
.docker/

# ── Testes ────────────────────────────────────────────
coverage/
.nyc_output/

# ── Playwright (artefatos locais — CI usa upload-artifact) ──────
playwright-report/
test-results/

# ── Claude Code (configuração local da IDE) ─────────────────────
.claude/

# ── Protótipos / assets gerados ───────────────────────
