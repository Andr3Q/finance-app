// ═══════════════════════════════════════════════════════
// 📐 prisma/schema.prisma — Modelo do Banco de Dados
//
// O Prisma lê este arquivo e cria as tabelas no PostgreSQL.
// Cada "model" vira uma tabela. Cada campo vira uma coluna.
// Ao alterar este arquivo, rode: npx prisma migrate dev
// ═══════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Tabela: users ───────────────────────────────────────
// Armazena os dados do usuário (apenas um neste caso)
model User {
  id              String        @id @default(uuid())
  name            String
  email           String        @unique
  password        String
  salary          Decimal       @default(0)
  reportEmail     String?
  createdAt       DateTime      @default(now())
  // Controla o mês/ano do último lançamento automático de contas fixas
  autoLaunchMonth  Int?
  autoLaunchYear   Int?
  resetToken       String?
  resetTokenExpiry DateTime?
  plan                 String    @default("free")
  planExpiresAt        DateTime?
  trialEndsAt          DateTime?
  referralCode         String?   @unique
  referredBy           String?
  // Marca quando ESTE usuário (como indicado) já disparou a recompensa do seu
  // indicador — impede reprocessamento do mesmo indicado conceder o bônus de
  // novo (corrida em /verify-email). Contagem de quantas recompensas ESTE
  // usuário (como indicador) já deu — parte do mesmo lock otimista que credita
  // os dias, fechando a corrida do teto de 5 entre indicados diferentes
  // verificando ao mesmo tempo. Achado de auditoria de segurança, 2026-10-21.
  referralRewardedAt   DateTime?
  referralRewardsGiven Int       @default(0)
  twoFactorSecret      String?
  twoFactorEnabled     Boolean   @default(false)
  tokenVersion         Int       @default(0)
  lastUsedTotpToken    String?
  lastUsedTotpAt       DateTime?
  onboardingComplete   Boolean   @default(false)
  renewalReminderSent  Boolean   @default(false)
  trialReminderSent    Boolean   @default(false)
  weeklyDigestSentAt   DateTime?
  emailVerified        Boolean   @default(false)
  // Foto de perfil (tela "Dados pessoais", Nancy 2): a imagem fica em UserAvatar (fora desta linha, pra
  // não pesar nas leituras do usuário); aqui só a data da última troca — null = sem foto, e serve de
  // versão no endereço da imagem (/auth/avatar?v=...).
  avatarUpdatedAt      DateTime?
  avatar               UserAvatar?
  emailVerifyToken     String?
  emailVerifyExpiry    DateTime?
  // Verificação por código de 6 dígitos (tela "Confirme seu e-mail", Nancy 2) —
  // caminho alternativo ao link acima, pro mesmo e-mail/evento. Expira rápido
  // (15min, não 24h como o link) e conta tentativas erradas: 6 dígitos tem
  // entropia baixa demais (1 em 1M) pra confiar só no rate limit por IP.
  emailVerifyCode          String?
  emailVerifyCodeExpiry    DateTime?
  emailVerifyCodeAttempts  Int       @default(0)
  // Troca de e-mail de login: o e-mail novo só é aplicado (email = pendingEmail)
  // depois que o link de confirmação (enviado pro endereço NOVO) é clicado —
  // evita trocar pra um e-mail que a pessoa não tem acesso de verdade.
  pendingEmail         String?
  pendingEmailToken    String?
  pendingEmailExpiry   DateTime?
  planPeriod           String?   @default("monthly")
  notifBudgetAlert     Boolean   @default(true)
  notifBudgetReminder  Boolean   @default(true)
  // Preferências da tela "Preferências" (Nancy 2). notifSalary/Stories/Tips mandam nos avisos dentro do app;
  // notifWeeklyEmail liga o resumo semanal por e-mail (segunda-feira, job /api/cron/weekly-digest).
  notifSalary          Boolean   @default(true)
  notifStories         Boolean   @default(true)
  notifTips            Boolean   @default(true)
  notifWeeklyEmail     Boolean   @default(false)
  budgetAlertMonth     Int?
  budgetAlertYear      Int?
  budgetReminderSentAt DateTime?

  // Proteção anti-brute-force: conta falhas consecutivas e marca bloqueio
  failedLoginCount     Int       @default(0)
  accountLockedAt      DateTime?

  transactions         Transaction[]
  twoFactorBackupCodes TwoFactorBackupCode[]
  budgets              Budget[]
  categoryLimits       CategoryLimit[]
  pushSubscriptions    PushSubscription[]
  goals                Goal[]
  installmentPlans     InstallmentPlan[]
  accountUnlockTokens  AccountUnlockToken[]

  @@index([resetToken])        // busca de reset-password usa findFirst por hash — sem índice = full scan
  @@index([emailVerifyToken])  // busca de verify-email usa findFirst por hash — padrão idêntico ao resetToken
  @@index([pendingEmailToken]) // busca de confirm-email-change usa findFirst por hash — mesmo padrão
}

// ── Tabela: transactions ────────────────────────────────
// Armazena cada gasto ou entrada registrada pelo usuário
model Transaction {
  id          String   @id @default(uuid())
  description String                              // Ex: "Almoço no restaurante"
  amount      Decimal                             // Valor em reais
  type        String                              // "expense" (gasto) ou "income" (entrada)
  category    String                              // "food", "shopping", "transport", etc.
  date        DateTime @default(now())            // Data/hora do registro
  archived    Boolean  @default(false)            // true = transação do mês fechado
  month       Int                                 // Mês da transação (1-12)
  year        Int                                 // Ano da transação

  // Vínculo opcional com a conta fixa que esta transação quita (pagamento
  // individual de uma Budget específica). NULL = transação avulsa, sem
  // relação com nenhuma conta fixa (ex: lançamento manual de categoria
  // "fixed" sem vínculo). onDelete SetNull preserva o histórico financeiro
  // se a conta fixa for excluída depois.
  budgetId    String?
  budget      Budget?  @relation(fields: [budgetId], references: [id], onDelete: SetNull)

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, month, year, archived])
  @@index([userId, type, month, year])
  // Garante no banco que uma conta fixa nunca é paga 2x no mesmo mês — rede
  // de segurança contra corrida (2 requests simultâneos) por trás do próprio
  // payBudget(). NULLs não colidem entre si no Postgres, então transações
  // avulsas (budgetId null) continuam sem nenhuma restrição.
  @@unique([budgetId, month, year])
}

// ── Tabela: budgets ─────────────────────────────────────
// Armazena as contas fixas mensais (aluguel, luz, etc.)
model Budget {
  id               String        @id @default(uuid())
  name             String                             // Ex: "Aluguel", "Internet"
  amount           Decimal                            // Valor mensal fixo
  dueDay           Int?                               // Dia do vencimento (1-31)
  endDate          DateTime?                          // Data final (conta com prazo, ex: parcelas)
  endDateNotifSent Boolean       @default(false)      // Notificação de expiração enviada

  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
}

// ── Tabela: category_limits ────────────────────────────
// Limite de gasto mensal por categoria (ex: máx R$300 em Alimentação)
model CategoryLimit {
  id       String @id @default(uuid())
  category String
  amount   Decimal
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
}

// ── Tabela: foto de perfil (1 por usuário) ──────────────
// JPEG 256x256 em data URL, já validado em PUT /auth/avatar (prefixo, base64 canônico, tamanho, assinatura).
model UserAvatar {
  userId    String   @id
  image     String
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Tabela: goals ───────────────────────────────────────
model Goal {
  id            String    @id @default(uuid())
  title         String
  targetAmount  Decimal
  currentAmount Decimal   @default(0)
  color         String    @default("#4ac46e")
  deadline      DateTime?
  createdAt     DateTime  @default(now())

  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Tabela: push_subscriptions ──────────────────────────
// Armazena as assinaturas Web Push de cada usuário
model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ── Tabela: installment_plans ───────────────────────────
// Compras parceladas: celular 12x, carro 48x, etc.
model InstallmentPlan {
  id                String   @id @default(uuid())
  name              String                           // Ex: "Celular Samsung"
  totalInstallments Int                              // Total de parcelas (12)
  paidInstallments  Int      @default(0)             // Quantas já foram pagas
  amount            Decimal                          // Valor de cada parcela
  startMonth          Int                            // Mês da 1ª parcela
  startYear           Int                            // Ano da 1ª parcela
  lastTransactionId   String?                        // ID da transação criada na última parcela paga (usado pelo /unpay)
  createdAt           DateTime @default(now())

  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Tabela: two_factor_backup_codes ────────────────────
// Códigos de recuperação 2FA (10 por usuário, HMAC-SHA256)
model TwoFactorBackupCode {
  id        String    @id @default(uuid())
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor_backup_codes")
}


// ── Tabela: processed_payments ──────────────────────────
// Deduplicação de webhooks do Mercado Pago — impede que o mesmo pagamento
// ative o plano duas vezes se o MP reenviar a notificação.
model ProcessedPayment {
  id          String   @id @default(uuid())
  paymentId   String   @unique
  userId      String
  plan        String
  period      String
  processedAt DateTime @default(now())
  // Detalhes vindos do webhook do Mercado Pago (nulos nos pagamentos antigos): valor cobrado, forma ('card' | 'pix')
  // e final do cartão (4 dígitos, nunca o número).
  amount      Decimal? @db.Decimal(10, 2)
  method      String?
  cardLast4   String?

  @@index([userId])
  @@map("processed_payments")
}

// ── Tabela: account_unlock_tokens ──────────────────────
// Token enviado por email para desbloquear conta após 10 tentativas falhas.
// Mesmo padrão do resetToken: hash SHA-256 no banco, nunca texto puro.
model AccountUnlockToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique          // SHA-256 do token enviado no email
  expiresAt DateTime                   // Expira em 1 hora
  usedAt    DateTime?                  // Preenchido quando o link é clicado (uso único)
  createdAt DateTime  @default(now())

  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account_unlock_tokens")
}

// ── Tabela: login_audits ────────────────────────────────
// Log de todas as tentativas de login — permite detectar ataques de força
// bruta, contas comprometidas e acessos suspeitos por IP.
model LoginAudit {
  id        String   @id @default(uuid())
  email     String
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([success, createdAt])
  @@index([ip, createdAt])
  @@map("login_audits")
}

