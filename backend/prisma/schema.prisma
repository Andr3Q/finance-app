// ═══════════════════════════════════════════════════════
// 📐 prisma/schema.prisma — Modelo do Banco de Dados
//
// O Prisma lê este arquivo e cria as tabelas no PostgreSQL.
// Cada "model" vira uma tabela. Cada campo vira uma coluna.
// Ao alterar este arquivo, rode: npx prisma migrate dev
// ═══════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Tabela: users ───────────────────────────────────────
// Armazena os dados do usuário (apenas um neste caso)
model User {
  id              String        @id @default(uuid())
  name            String
  email           String        @unique
  password        String
  salary          Decimal       @default(0)
  reportEmail     String?
  createdAt       DateTime      @default(now())
  // Controla o mês/ano do último lançamento automático de contas fixas
  autoLaunchMonth  Int?
  autoLaunchYear   Int?
  resetToken       String?
  resetTokenExpiry DateTime?
  plan                 String    @default("free")
  planExpiresAt        DateTime?
  trialEndsAt          DateTime?
  referralCode         String?   @unique
  referredBy           String?
  twoFactorSecret      String?
  twoFactorEnabled     Boolean   @default(false)
  tokenVersion         Int       @default(0)
  lastUsedTotpToken    String?
  lastUsedTotpAt       DateTime?
  onboardingComplete   Boolean   @default(false)
  renewalReminderSent  Boolean   @default(false)
  trialReminderSent    Boolean   @default(false)
  weeklyDigestSentAt   DateTime?
  emailVerified        Boolean   @default(false)
  emailVerifyToken     String?
  emailVerifyExpiry    DateTime?
  // Troca de e-mail de login: o e-mail novo só é aplicado (email = pendingEmail)
  // depois que o link de confirmação (enviado pro endereço NOVO) é clicado —
  // evita trocar pra um e-mail que a pessoa não tem acesso de verdade.
  pendingEmail         String?
  pendingEmailToken    String?
  pendingEmailExpiry   DateTime?
  planPeriod           String?   @default("monthly")
  notifBudgetAlert     Boolean   @default(true)
  notifBudgetReminder  Boolean   @default(true)
  budgetAlertMonth     Int?
  budgetAlertYear      Int?
  budgetReminderSentAt DateTime?

  // Proteção anti-brute-force: conta falhas consecutivas e marca bloqueio
  failedLoginCount     Int       @default(0)
  accountLockedAt      DateTime?

  transactions         Transaction[]
  twoFactorBackupCodes TwoFactorBackupCode[]
  budgets              Budget[]
  categoryLimits       CategoryLimit[]
  pushSubscriptions    PushSubscription[]
  goals                Goal[]
  installmentPlans     InstallmentPlan[]
  accountUnlockTokens  AccountUnlockToken[]

  @@index([resetToken])        // busca de reset-password usa findFirst por hash — sem índice = full scan
  @@index([emailVerifyToken])  // busca de verify-email usa findFirst por hash — padrão idêntico ao resetToken
  @@index([pendingEmailToken]) // busca de confirm-email-change usa findFirst por hash — mesmo padrão
}

// ── Tabela: transactions ────────────────────────────────
// Armazena cada gasto ou entrada registrada pelo usuário
model Transaction {
  id          String   @id @default(uuid())
  description String                              // Ex: "Almoço no restaurante"
  amount      Decimal                             // Valor em reais
  type        String                              // "expense" (gasto) ou "income" (entrada)
  category    String                              // "food", "shopping", "transport", etc.
  date        DateTime @default(now())            // Data/hora do registro
  archived    Boolean  @default(false)            // true = transação do mês fechado
  month       Int                                 // Mês da transação (1-12)
  year        Int                                 // Ano da transação

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, month, year, archived])
  @@index([userId, type, month, year])
}

// ── Tabela: budgets ─────────────────────────────────────
// Armazena as contas fixas mensais (aluguel, luz, etc.)
model Budget {
  id               String    @id @default(uuid())
  name             String                         // Ex: "Aluguel", "Internet"
  amount           Decimal                        // Valor mensal fixo
  dueDay           Int?                           // Dia do vencimento (1-31)
  endDate          DateTime?                      // Data final (conta com prazo, ex: parcelas)
  endDateNotifSent Boolean   @default(false)      // Notificação de expiração enviada

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Tabela: category_limits ────────────────────────────
// Limite de gasto mensal por categoria (ex: máx R$300 em Alimentação)
model CategoryLimit {
  id       String @id @default(uuid())
  category String
  amount   Decimal
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
}

// ── Tabela: goals ───────────────────────────────────────
model Goal {
  id            String    @id @default(uuid())
  title         String
  targetAmount  Decimal
  currentAmount Decimal   @default(0)
  color         String    @default("#4ac46e")
  deadline      DateTime?
  createdAt     DateTime  @default(now())

  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Tabela: push_subscriptions ──────────────────────────
// Armazena as assinaturas Web Push de cada usuário
model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ── Tabela: installment_plans ───────────────────────────
// Compras parceladas: celular 12x, carro 48x, etc.
model InstallmentPlan {
  id                String   @id @default(uuid())
  name              String                           // Ex: "Celular Samsung"
  totalInstallments Int                              // Total de parcelas (12)
  paidInstallments  Int      @default(0)             // Quantas já foram pagas
  amount            Decimal                          // Valor de cada parcela
  startMonth          Int                            // Mês da 1ª parcela
  startYear           Int                            // Ano da 1ª parcela
  lastTransactionId   String?                        // ID da transação criada na última parcela paga (usado pelo /unpay)
  createdAt           DateTime @default(now())

  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Tabela: two_factor_backup_codes ────────────────────
// Códigos de recuperação 2FA (10 por usuário, HMAC-SHA256)
model TwoFactorBackupCode {
  id        String    @id @default(uuid())
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor_backup_codes")
}


// ── Tabela: processed_payments ──────────────────────────
// Deduplicação de webhooks do Mercado Pago — impede que o mesmo pagamento
// ative o plano duas vezes se o MP reenviar a notificação.
model ProcessedPayment {
  id          String   @id @default(uuid())
  paymentId   String   @unique
  userId      String
  plan        String
  period      String
  processedAt DateTime @default(now())

  @@index([userId])
  @@map("processed_payments")
}

// ── Tabela: account_unlock_tokens ──────────────────────
// Token enviado por email para desbloquear conta após 10 tentativas falhas.
// Mesmo padrão do resetToken: hash SHA-256 no banco, nunca texto puro.
model AccountUnlockToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique          // SHA-256 do token enviado no email
  expiresAt DateTime                   // Expira em 1 hora
  usedAt    DateTime?                  // Preenchido quando o link é clicado (uso único)
  createdAt DateTime  @default(now())

  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account_unlock_tokens")
}

// ── Tabela: login_audits ────────────────────────────────
// Log de todas as tentativas de login — permite detectar ataques de força
// bruta, contas comprometidas e acessos suspeitos por IP.
model LoginAudit {
  id        String   @id @default(uuid())
  email     String
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([success, createdAt])
  @@index([ip, createdAt])
  @@map("login_audits")
}

